# ── NeuroVault / FinMotion AI — Environment Variables ──────────────────────────
# Copy to .env and fill in your API keys.
# cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://neurovault:neurovault_pass@localhost:5432/stocktracker
# SQLite for local dev (no Docker needed):
# DATABASE_URL=sqlite:///./finmotion.db

POSTGRES_USER=neurovault
POSTGRES_PASSWORD=neurovault_pass
POSTGRES_DB=stocktracker

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AI / LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# Gemini — single key for intel_service.py / quant_service.py
GEMINI_API_KEY=...

# Gemini rotation pool — gemini_layer.py cycles through all 3 to stay under rate limits
GEMINI_API_KEY_1=AIza...
GEMINI_API_KEY_2=AIza...
GEMINI_API_KEY_3=AIza...

# ── Market data ───────────────────────────────────────────────────────────────
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...
POLYGON_API_KEY=...

# ── News ──────────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=...
BENZINGA_API_KEY=...        # optional — NewsAPI fallback used if absent
NEWS_API_KEY=...            # fallback news source

# ── Macroeconomic ─────────────────────────────────────────────────────────────
FRED_API_KEY=...

# ── Indicator defaults (overridable per user) ─────────────────────────────────
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD_DEV=2.0
ATR_PERIOD=14

# ── Composite signal weights (must sum to 1.0) ────────────────────────────────
W_TECHNICAL=0.40
W_SENTIMENT=0.35
W_FUNDAMENTAL=0.25

# ── Signal thresholds ─────────────────────────────────────────────────────────
THRESHOLD_STRONG_BUY=0.60
THRESHOLD_BUY=0.25
THRESHOLD_SELL=-0.25
THRESHOLD_STRONG_SELL=-0.60

# ── NLP / RAG / Embeddings ────────────────────────────────────────────────────
# voyage-3-lite: $0.02/1M tokens (~free for personal use)
# Get key at: https://dash.voyageai.com
VOYAGE_API_KEY=pa-...

# ── Web Search ────────────────────────────────────────────────────────────────
# Recommended: Serper ($1/1000 queries) — cheapest, Google results
# Get key at: https://serper.dev  (free trial: 2500 queries)
SERPER_API_KEY=...

# Fallback: Brave ($3/1000 queries) — no Google dependency
# Get key at: https://brave.com/search/api
BRAVE_SEARCH_API_KEY=...

# Which provider to use first (serper | brave)
SEARCH_PROVIDER=serper
SEARCH_MAX_RESULTS=6
SEARCH_MAX_TOKENS=5000

# ── Vercel deployment (frontend only) ─────────────────────────────────────────
# Leave unset for local `docker compose up` (frontend defaults to http://localhost:8000).
# Only set this when deploying the frontend standalone against a remote backend/tunnel.
# VITE_API_BASE=https://your-cloudflare-tunnel.trycloudflare.com

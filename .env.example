# ── NeuroVault / FinMotion AI — Environment Variables ──────────────────────────
# Copy to .env and fill in your API keys.
# cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neurovault:neurovault_pass@localhost:5432/stocktracker
# SQLite for local dev (no Docker needed):
# DATABASE_URL=sqlite:///./finmotion.db

POSTGRES_USER=neurovault
POSTGRES_PASSWORD=neurovault_pass
POSTGRES_DB=stocktracker

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# ── Market data ───────────────────────────────────────────────────────────────
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...
POLYGON_API_KEY=...

# ── News ──────────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=...
BENZINGA_API_KEY=...        # optional — NewsAPI fallback used if absent
NEWS_API_KEY=...            # fallback news source

# ── Macroeconomic ─────────────────────────────────────────────────────────────
FRED_API_KEY=...

# ── Indicator defaults (overridable per user) ─────────────────────────────────
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_PERIOD=20
BB_STD_DEV=2.0
ATR_PERIOD=14

# ── Composite signal weights (must sum to 1.0) ────────────────────────────────
W_TECHNICAL=0.40
W_SENTIMENT=0.35
W_FUNDAMENTAL=0.25

# ── Signal thresholds ─────────────────────────────────────────────────────────
THRESHOLD_STRONG_BUY=0.60
THRESHOLD_BUY=0.25
THRESHOLD_SELL=-0.25
THRESHOLD_STRONG_SELL=-0.60

# ── Vercel deployment (frontend only) ─────────────────────────────────────────
VITE_API_BASE=https://your-cloudflare-tunnel.trycloudflare.com
